# X Developer app: OAuth 1.0a user credentials with Read and Write permissions.
# Generate the user access token AFTER enabling write permissions.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BOT_HANDLE=grook

# Same provider as the site's chat. Keep server-side; never NEXT_PUBLIC_.
XAI_API_KEY=
XAI_MODEL=grok-4.20-0309-non-reasoning

# Preview first. Only enable both after X grants AI-reply approval.
X_BOT_LIVE=false
X_AI_REPLY_APPROVED=false
POLL_SECONDS=60
MAX_REPLIES_PER_DAY=50
# Persistent disk directory; default ./data beside bot.py
# DATA_DIR=/data
